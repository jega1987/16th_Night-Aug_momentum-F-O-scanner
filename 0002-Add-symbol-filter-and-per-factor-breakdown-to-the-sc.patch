     """No-op when DASHBOARD_TOKEN is unset. Otherwise accepts ?token=,
     an X-Dashboard-Token header, or a cookie set on first successful visit."""
@@ -97,6 +104,8 @@ async def health(db: Session = Depends(get_db)):
 @app.get("/")
