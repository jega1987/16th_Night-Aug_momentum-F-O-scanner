-    logs = safe(
-        "scan log",
-        lambda: (db.query(ScanLog).filter(ScanLog.timeframe == tf)
-                   .order_by(ScanLog.timestamp.desc()).limit(40).all()),
-        [])
+    symbols_filter = _parse_symbol_filter(symbol)
+
+    def load_logs():
