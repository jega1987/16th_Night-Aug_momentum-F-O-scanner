+def _parse_symbol_filter(raw: Optional[str]) -> list:
+    """'hindalco, nifty 50' -> ['HINDALCO', 'NIFTY 50']. Blank/None -> []."""
+    if not raw:
+        return []
+    return [s.strip().upper() for s in raw.split(",") if s.strip()]
+
+
