# ---------- feed ----------
# mock = synthetic candles, no broker needed. Use this for the first deploy.
FEED_MODE=kite


# ---------- database ----------
# Railway injects this automatically once you add the Postgres plugin.
# Leave blank locally to use ./data/scanner.db
DATABASE_URL=

# ---------- strategy ----------
SCAN_TIMEFRAME=5m
HTF_TIMEFRAME=15m
INDICES=NIFTY 50,BANKNIFTY,SENSEX
MIN_SQUEEZE_BARS=6
MAX_BARS_SINCE_FIRE=3
SQUEEZE_RANGE_MAX_BARS=20
VOLUME_MULT=1.5
ADX_THRESHOLD=20
USE_RSI_FILTER=true
RSI_LONG_MIN=60
RSI_SHORT_MAX=40
USE_OI_FILTER=true
MIN_OI_CHANGE_PCT=0.25
MIN_COMPOSITE=0.70
HARD_FAIL_FACTORS=direction,squeeze,volume,adx

# ---------- risk ----------
ACCOUNT_BALANCE=1000000
RISK_PER_TRADE_PCT=1.0
MAX_RISK_PER_TRADE_PCT=2.0
ATR_SL_MULT=1.5
MAX_SL_DISTANCE_PCT=2.0
COOLDOWN_BARS=12
MAX_SIGNALS_PER_DAY=12
# Round-trip cost model (index futures). Options on premium cost more.
COST_PCT_PER_SIDE=0.00005
BROKERAGE_PER_LEG=20
# Verify against the current exchange circular before going live.
LOT_SIZES={"NIFTY 50": 75, "BANKNIFTY": 35, "SENSEX": 20}

# ---------- options overlay ----------
OPTIONS_ENABLED=true
# false = a blocked option leg still leaves a futures-level signal on the board
OPTIONS_BLOCK_SIGNAL=false
OPTIONS_BLOCK_ON_MISSING_DATA=false
# IV rank band. Needs history before it applies - see IV_RANK_MIN_* below.
MIN_IV_RANK=20
MAX_IV_RANK=80
IV_RANK_LOOKBACK_DAYS=90
IV_RANK_MIN_SAMPLES=60
IV_RANK_MIN_DAYS=10
IV_SAMPLE_MINUTES=15
# No new option entries after this IST time on the day the contract expires.
THETA_CUTOFF_TIME=13:30
EXPIRY_DAY_ROLLOVER=true
# Theta paid over a typical hold, as a % of the expected move to TP1.
EXPECTED_HOLD_HOURS=2.0
MAX_THETA_DRAG_PCT=33
# 0 disables the flat per-day ceiling (see config.py for why)
MAX_THETA_PCT_PER_DAY=0
RISK_FREE_RATE=0.065

# ---------- exits ----------
USE_SUPERTREND_EXIT=true
ST_PERIOD=10
ST_MULT=3.0

# ---------- access + alerts ----------
DASHBOARD_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO

# ---------- API budget ----------
# Store closed candles and reuse them instead of re-downloading every cycle.
USE_CANDLE_STORE=true
# Derive 15m bars from stored 5m bars - removes one API call per symbol/cycle.
DERIVE_HTF=true
CANDLE_RETENTION_DAYS=30
# Concurrency limit (how many calls at once)
MAX_CONCURRENT_FETCHES=3
# Rate limit (how many calls per second) - a different thing entirely
API_CALLS_PER_SECOND=3

# ---------- dynamic equity universe ----------
EQUITY_ENABLED=true
UNIVERSE_SIZE=200
MIN_STOCK_PRICE=200
MIN_TURNOVER_CR=5
RANK_W_TURNOVER=0.6
RANK_W_MOMENTUM=0.4
MOMENTUM_DAYS=5
QUOTE_BATCH_SIZE=50

# ---------- index isolation (stocks get their own bars) ----------
EQ_VOLUME_MULT=2.0
EQ_ADX_THRESHOLD=25
EQ_MIN_COMPOSITE=0.75
EQ_ATR_SL_MULT=2.0
EQ_MAX_SL_DISTANCE_PCT=3.0

# ---------- websocket streaming ----------
USE_WEBSOCKET=true
WS_RECONNECT_SECONDS=15
WS_STALE_SECONDS=120
WS_UNSUBSCRIBE_AT_CAP=true

# ---------- strict cap ----------
MAX_SIGNALS_PER_DAY=5

# ---------- decoupled processes ----------
# On the web service set RUN_SCHEDULER=false and run a second Railway service
# with RUN_MODE=worker against the same DATABASE_URL.
RUN_SCHEDULER=true

# ---------- broker: kite | mock ----------
FEED_MODE=kite

# ---------- Kite Connect ----------
KITE_API_KEY=
KITE_API_SECRET=
# Leave blank. Kite tokens expire every morning and are minted through a
# browser redirect, so sign in at /kite/login each day - the token is stored in
# the database and survives restarts. Register the redirect URL on the Kite
# developer console as: https://<your-app>.up.railway.app/kite/callback
KITE_ACCESS_TOKEN=
PUBLIC_URL=

# ---------- option liquidity (needs a feed with depth - Kite has it) ----------
MAX_SPREAD_DRAG_PCT=25
MIN_OPTION_OI=50000
